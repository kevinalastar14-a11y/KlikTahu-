# ---- Konfigurasi video panjang 16:9 (dibaca workflow render_long.yml) ----
LONG_SLUG=v02_laut_dalam
LONG_TITLE="Perjalanan ke Dasar Laut Terdalam di Bumi"
OUT_NAME=KlikTahu_Long02_LautDalam
# visual
W=1920
H=1080
FPS=30
SS=1.25
# audio (durasi bebas; pace santai sama seperti Shorts)
SPEED=1.09
TARGET_WPS=1.90
MAXDUR=3600
# naskah padat angka (dibaca cepat oleh TTS) -> izinkan perlambatan sedikit lebih besar
export ATEMPO_MIN=0.85
# encode 1080p30
VBITRATE=9000k
MAXRATE=14000k
BUFSIZE=20000k
PRESET=slow
TUNE=animation
ABITRATE=256k
# paralelisme
CHUNKS=8
JOBS=4
