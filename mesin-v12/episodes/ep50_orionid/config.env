# ---- Konfigurasi episode (runner lokal; TIDAK di GitHub Actions) ----
EPISODE_SLUG=ep50_orionid
EPISODE_TITLE="Hujan Meteor Orionid 21-22 Oktober: Jam Berapa & Arah Mana (Tanpa Teleskop)"
OUT_NAME=KlikTahu_Ep50_Orionid
# visual
FPS=60
SS=1.5
SHARPEN=52
# audio (standar v12: VO -> SFX per BEAT (sinkron kata) -> ambient angin malam halus; tanpa musik)
# v2: VO lewat vo_manusia.py (sumber .wav, tanpa atempo); SPEED/TARGET_WPS hanya dipakai rantai lama
SPEED=1.09
TARGET_WPS=2.05
ATEMPO_MIN=0.93
KT_VO_CHAIN=v12
# visual v2: grain lebih halus (bersih setelah re-encode YouTube)
KT_GRAIN=2.4
MAXDUR=178
# encode (sama dengan Ep24-49)
VBITRATE=5900k
MAXRATE=11000k
BUFSIZE=16000k
PRESET=slow
TUNE=animation
ABITRATE=256k
# paralelisme (sandbox 2 vCPU / 2 GB)
CHUNKS=8
JOBS=2
