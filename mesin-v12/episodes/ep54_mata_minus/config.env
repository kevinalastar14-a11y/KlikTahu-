# ---- Konfigurasi episode (runner lokal; TIDAK di GitHub Actions) ----
EPISODE_SLUG=ep54_mata_minus
EPISODE_TITLE="Mata Minus Tidak Bisa Sembuh — Bola Matanya Sudah Memanjang"
OUT_NAME=KlikTahu_Ep54_MataMinus
# visual
FPS=60
SS=1.5
SHARPEN=50
# latar: ilustrasi penuh layar v15 -> mesh dimatikan (warna dasar digambar tangan)
KT_MESH=0
# gaya ilustrasi penuh layar: progress bar HUD di y=0 dimatikan (melanggar margin 40 px)
KT_PROGRESS=0
# audit kasar "sentuh tepi" di qc_mp4 tidak berlaku untuk latar full-bleed
KT_FULLBLEED=1
# finishing V14 (pendar, lindung highlight, CA tepi, kontras lokal, dither, grain)
KT_FINISH=v14
KT_GRAIN=2.2
# audio (standar v12: VO -> SFX per BEAT -> ambient ruang; tanpa musik)
SPEED=1.09
TARGET_WPS=2.05
MAXDUR=178
# encode
VBITRATE=6400k
MAXRATE=11000k
BUFSIZE=16000k
PRESET=slow
TUNE=animation
ABITRATE=256k
# paralelisme (mesin 2 core)
CHUNKS=8
JOBS=2
