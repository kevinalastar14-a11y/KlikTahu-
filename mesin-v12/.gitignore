# ===========================================================================
#  .gitignore KlikTahu — apa pun yang bisa dibuat ulang / besar / rahasia
#  TIDAK masuk repo. Aturan ini bagian dari keamanan akun (AGEN.md §14).
# ===========================================================================

# --- artefak render (dibuat ulang tiap kali) -------------------------------
build/
build_v18/
build_v19/
build_v20/
build_v21/
frames/
frames*/
parts/
part_*.mp4
video_master.mp4
# hasil render yang diserahkan ke pemilik (binari, bukan kode).
# PENTING: jangan taruh komentar di baris yang sama dengan pola — gitignore
# menganggap seluruh baris sebagai pola sehingga aturannya tidak pernah cocok.
keluaran/
dist/
*.mp4
*.mov
*.m4a
*.wav
*.mkv
*.webm

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- naskah & timeline kerja (salinan di akar, asli ada di episodes/) ------
/content.json
/timeline.json
/list.txt
qc*.json

# --- audio mentah & hasil olahan (lihat docs/audio-manifest.md) ------------
# `audio/*` (bukan `audio/`): git TIDAK bisa meng-un-ignore berkas di dalam
# direktori yang sudah diabaikan seluruhnya. Dengan `audio/*`, isi folder tetap
# terabaikan tapi pengecualian di bawah bisa aktif.
audio/*
# kecuali: klip VO per babak + timing — kecil (~350 KB), sumber produksi,
# dan dipakai langkah CI "QC audio VO".
!audio/vo/
!audio/vo/sumber/
!audio/vo/sumber/*.mp3
!audio/vo/sumber_kilat/
!audio/vo/sumber_kilat/*.mp3
!audio/vo/timing.json
!audio/vo57/
!audio/vo57/sumber/
!audio/vo57/sumber/*.mp3
!audio/vo57/timing.json
!audio/vo57_kilat/
!audio/vo57_kilat/sumber/
!audio/vo57_kilat/sumber/*.mp3
!audio/vo57_kilat/timing.json
!audio/vo_kilat/
!audio/vo57/
!audio/vo57/sumber/
!audio/vo57/sumber/*.mp3
!audio/vo57/timing.json
!audio/vo57_kilat/
!audio/vo57_kilat/sumber/
!audio/vo57_kilat/sumber/*.mp3
!audio/vo57_kilat/timing.json
!audio/vo_kilat/timing.json
# Episode v21 (gaya kertas): klip VO + timing ikut repo, campuran/master tidak.
!audio/vo58/
!audio/vo58/sumber/
!audio/vo58/sumber/*.mp3
!audio/vo58/timing.json
# ...tapi hasil pengukuran (loudness dsb) bukan sumber: biar tidak ikut commit.
audio/vo/master.json
audio/vo_kilat/master.json
audio/vo57/master.json
audio/vo57_kilat/master.json
audio/vo58/master.json
audio/vo58/campuran*.wav
audio_proc/
audio_tmp/
episodes/*/audio_raw/*
long/*/audio_raw/*

# --- dokumen pribadi -------------------------------------------------------
docs/*.local
*.local.md

# --- KEAMANAN: jangan pernah commit rahasia / kredensial -------------------
.env
.env.*
*.pem
*.key
*.p12
*token*.txt
*secret*
credentials*.json
service-account*.json
.netrc
.git-credentials

# --- unggahan & pratinjau lokal --------------------------------------------
uploads/
*.log
